ios/Nacelle.xcodeproj/
ios/Nacelle/Info.plist
# App Mac : projet et Info.plist générés par xcodegen
mac/app/PTZBot.xcodeproj/
mac/app/PTZBot/Info.plist
ios/Config/Local.xcconfig
ios/Local/

